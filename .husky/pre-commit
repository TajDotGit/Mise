# Secret scan of staged changes, then lint and type check.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed (brew install gitleaks). Refusing to commit." >&2
  exit 1
fi
gitleaks git --pre-commit --staged --redact --verbose --config .gitleaks.toml . || exit 1
npm run lint || exit 1
npm run typecheck || exit 1
